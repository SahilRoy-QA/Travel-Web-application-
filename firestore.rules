rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (request.auth.token.email.lower() == 'roysahil579@gmail.com' ||
         request.auth.token.email.lower() == 'dassahil3@gmail.com');
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    function isAgent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    // Validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Test doc for connection check
    match /test/{testId} {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role == 'customer' ||
        request.resource.data.role == 'agent' ||
        (isSuperAdminEmail() && request.resource.data.role in ['admin', 'super_admin'])
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferences']) ||
         (request.resource.data.preferences.theme in ['light', 'dark', 'system']))
      );
      allow delete: if isAdmin();
    }

    // Hotels
    match /hotels/{hotelId} {
      allow get, list: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Rooms
    match /rooms/{roomId} {
      allow get, list: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalInventory'])
      );
      allow create, delete: if isAdmin();
    }

    // Room Inventory
    match /roomInventory/{inventoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Packages
    match /packages/{packageId} {
      allow get, list: if resource.data.isPublished == true || isAdmin() || (
        isAgent() && resource.data.agentId == request.auth.uid
      );
      allow create: if isAdmin() || (
        isAgent() && request.resource.data.agentId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isAgent() && resource.data.agentId == request.auth.uid
      );
    }

    // Services
    match /services/{serviceId} {
      allow get, list: if resource.data.isAvailable == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Destinations
    match /destinations/{destId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Banners
    match /banners/{bannerId} {
      allow get, list: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow get, list: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Settings (branding, homepage sections, feature flags, policies)
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow get: if (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isAgent() && resource.data.agentId == request.auth.uid)
      )) || (!isSignedIn() && resource.data.userId == 'guest_traveler');
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isAgent() && resource.data.agentId == request.auth.uid)
      );
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
                       (!isSignedIn() && request.resource.data.userId == 'guest_traveler') ||
                       isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.bookingStatus == 'cancelled' &&
        resource.data.bookingStatus in ['confirmed', 'pending'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'cancellationReason', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow get, list: if resource.data.isApproved == true || isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Wishlists
    match /wishlists/{wishlistId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Agents
    match /agents/{agentId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
    }

    // Hero Photo Carousel Config and Slides
    function isValidCarouselConfig(data) {
      return data.enabled is bool &&
             data.intervalMs is number && data.intervalMs >= 2000 && data.intervalMs <= 15000 &&
             data.transitionMs is number && data.transitionMs >= 300 && data.transitionMs <= 2000 &&
             data.transitionType in ['fade', 'slide', 'kenburns'] &&
             data.scrimOpacityLight is number && data.scrimOpacityLight >= 0.0 && data.scrimOpacityLight <= 1.0 &&
             data.scrimOpacityDark is number && data.scrimOpacityDark >= 0.0 && data.scrimOpacityDark <= 1.0;
    }

    function isValidCarouselSlide(data) {
      return data.altText is string && data.altText.size() >= 5 && data.altText.size() <= 200 &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 120)) &&
             (!('linkUrl' in data) || (data.linkUrl is string && (data.linkUrl.size() == 0 || data.linkUrl.matches('^/.*') || data.linkUrl.matches('^https://.*')))) &&
             data.active is bool &&
             data.order is number &&
             data.focalX is number && data.focalX >= 0 && data.focalX <= 100 &&
             data.focalY is number && data.focalY >= 0 && data.focalY <= 100;
    }

    match /heroCarousel/config {
      allow read: if true;
      allow write: if isAdmin() && isValidCarouselConfig(request.resource.data);
    }

    match /heroCarousel/slides/items/{slideId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin() && isValidCarouselSlide(request.resource.data);
    }
  }
}
